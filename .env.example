# Copy to .env and fill in. NEVER commit .env, and never put a key that
# holds real (mainnet) funds here - use a fresh testnet-only account.

# --- Hardhat (deploy.js, governance.js) ---
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-project-id
PRIVATE_KEY=0xyour-testnet-only-private-key
ETHERSCAN_API_KEY=your-etherscan-api-key

# Optional: hand every contract to a multisig + timelock after deployment.
# GOVERNANCE_OWNERS=0xOwnerA,0xOwnerB,0xOwnerC
# GOVERNANCE_THRESHOLD=2
# TIMELOCK_DELAY=3600            # seconds; 1 hour keeps a live demo short
# FEATURE_ORACLE=0x...           # default: the deployer (= the router account)

# --- Off-chain router (off-chain/, uvicorn main:app) ---
# TRUSTTIER_RPC_URL=https://sepolia.infura.io/v3/your-project-id
# TRUSTTIER_NETWORK=sepolia
# TRUSTTIER_PRIVATE_KEY=0xsame-key-as-PRIVATE_KEY   # required off local chains
# TRUSTTIER_PROVER=auto          # auto | ezkl | mock
