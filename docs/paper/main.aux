\newlabel{fig:speedup}{{6}{14}{Pre-computed-schedule speedup of one traced block of 374 decisions. Deposit-funded bonds keep the block parallel whichever way an engine treats balance updates}{figure.caption.69}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Same-position contention in traced blocks of 200 decisions plus duplicates. Losing attempts revert at the lock and conflict only with the winner, so the block still needs just 2 strict rounds; speedup degrades gently. Optimistic aborts at 64 threads rise from 0 to 51 (Table\nonbreakingspace \ref {tab:parallel}).}}{14}{figure.caption.70}\protected@file@percent }
\newlabel{fig:contention}{{7}{14}{Same-position contention in traced blocks of 200 decisions plus duplicates. Losing attempts revert at the lock and conflict only with the winner, so the block still needs just 2 strict rounds; speedup degrades gently. Optimistic aborts at 64 threads rise from 0 to 51 (Table~\ref {tab:parallel})}{figure.caption.70}{}}
