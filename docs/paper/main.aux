\citation{qin2021liquidations}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces TrustTier in one picture. (a) Lending protocols liquidate only once LTV crosses the threshold, and a risk model that could act earlier runs off-chain, unchecked. (b) TrustTier's contract reads every input itself, computes the distance $\delta $ to the boundary and enforces how strongly each decision must be verified: a zero-knowledge proof near the boundary, cheap bonded claims far from it, with bands that widen for volatile collateral. (c) The result.}}{1}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:teaser}{{1}{1}{TrustTier in one picture. (a) Lending protocols liquidate only once LTV crosses the threshold, and a risk model that could act earlier runs off-chain, unchecked. (b) TrustTier's contract reads every input itself, computes the distance $\delta $ to the boundary and enforces how strongly each decision must be verified: a zero-knowledge proof near the boundary, cheap bonded claims far from it, with bands that widen for volatile collateral. (c) The result}{figure.caption.1}{}}
