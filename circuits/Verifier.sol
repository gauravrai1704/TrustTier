                mstore(0x0de0, 0x1f76ac45057791f4928860297bc7998ef2d3ea102f1b49dbac60627f37cd3779) // fixed_comms[6].y
                mstore(0x0e00, 0x2f267281e14a4ae7a64b3ec823db833b830e658dc7a1980dcb573096866415a1) // fixed_comms[7].x
